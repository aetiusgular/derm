+    // Inheriting its folder's entries (not protected): refused.
+    derm_core::platform::set_private_file(&tok).unwrap();
+    std::fs::write(&tok, "not a token").unwrap();
+    assert!(matches!(
+        client::read_daemon_token(&f.dir),
+        Err(ClientError::Token(_))
+    ));
+}
