+    );
+    let checks = lines
+        .iter()
+        .filter(|l| l["event"]["kind"] == "person.check")
+        .count();
+    assert_eq!(checks, 2, "both refused yeses are recorded");
+    let _ = sleeper.kill();
+    let _ = sleeper.wait();
