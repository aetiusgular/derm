{
  "suite": "effects",
  "id": "rename-outside",
  "source": {
    "name": "derm"
  },
  "split": "dev",
  "steps": [
    {
      "kind": "shell",
      "input": {
        "call": "npm run build",
        "payload": "echo x > scratch.tmp && mv scratch.tmp \"$HOME/moved.txt\""
      },
      "expect": "allow"
    }
  ],
  "effects": [
    {
      "what": "write",
      "path": "~/moved.txt"
    }
  ]
}
