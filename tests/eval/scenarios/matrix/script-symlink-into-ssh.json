{
  "suite": "matrix",
  "id": "script-symlink-into-ssh",
  "source": {
    "name": "openmoat",
    "version": "0.19.0",
    "path": "tests/differential/scenarios.yaml (scripts)",
    "licence": "MIT OR Apache-2.0"
  },
  "split": "dev",
  "steps": [
    {
      "kind": "shell",
      "input": {
        "payload": "rm -f keys; ln -s \"$HOME/.ssh\" keys && cat keys/id_rsa"
      }
    }
  ],
  "targets": [
    "host"
  ]
}
