      "input": {
        "command": "echo next > next-800.txt"
      },
      "expect": "allow"
    }
  ],
  "effects": [
    {
      "what": "write",
      "path": "late-800.txt",
      "after": 800
    },
    {
      "what": "write",
      "path": "next-800.txt"
    }
  ]
}
