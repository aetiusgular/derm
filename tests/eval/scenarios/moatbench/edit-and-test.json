{
  "suite": "moatbench",
  "id": "edit-and-test",
  "source": {
    "name": "openmoat",
    "version": "0.19.0",
    "licence": "MIT OR Apache-2.0",
    "path": "moatbench/benign.yaml"
  },
  "split": "dev",
  "steps": [
    {
      "kind": "read",
      "input": {
        "path": "src/lib.rs"
      },
      "expect": "allow"
    },
    {
      "kind": "write",
      "input": {
        "path": "src/lib.rs"
      },
      "expect": "allow"
    },
    {
      "kind": "shell",
      "input": {
        "command": "cargo test --workspace"
      },
      "expect": "allow"
    }
  ]
}
