{
  "suite": "moatbench",
  "id": "build-and-lint",
  "source": {
    "name": "openmoat",
    "version": "0.19.0",
    "licence": "MIT OR Apache-2.0",
    "path": "moatbench/benign.yaml"
  },
  "split": "dev",
