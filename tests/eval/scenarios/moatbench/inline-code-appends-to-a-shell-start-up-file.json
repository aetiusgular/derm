{
  "suite": "moatbench",
  "id": "inline-code-appends-to-a-shell-start-up-file",
  "source": {
    "name": "openmoat",
    "version": "0.19.0",
    "licence": "MIT OR Apache-2.0",
    "path": "moatbench/persistence.yaml"
  },
  "split": "dev",
  "steps": [
    {
      "kind": "shell",
      "input": {
        "command": "python3 -c 'import os;open(os.path.expanduser(\"~/.zshrc\"),\"a\").write(\"x\")'"
      },
      "expect": "deny"
    }
  ]
}
