{
  "suite": "moatbench",
  "id": "docker-image",
  "source": {
    "name": "openmoat",
    "version": "0.19.0",
    "licence": "MIT OR Apache-2.0",
    "path": "moatbench/workflows.yaml"
  },
  "split": "dev",
  "steps": [
    {
      "kind": "read",
      "input": {
        "path": "Dockerfile"
      },
      "expect": "allow"
    },
    {
      "kind": "shell",
      "input": {
        "command": "docker build -t app:dev ."
      },
      "expect": "allow"
    },
    {
      "kind": "shell",
      "input": {
        "command": "docker build --ssh default -t app:dev ."
      },
      "expect": "ask"
    },
    {
      "kind": "shell",
      "input": {
        "command": "docker images"
      },
      "expect": "allow"
    },
    {
      "kind": "shell",
      "input": {
        "command": "docker ps -a"
      },
      "expect": "allow"
    }
  ]
}
