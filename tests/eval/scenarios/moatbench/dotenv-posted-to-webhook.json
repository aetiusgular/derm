{
  "suite": "moatbench",
  "id": "dotenv-posted-to-webhook",
  "source": {
    "name": "openmoat",
    "version": "0.19.0",
    "licence": "MIT OR Apache-2.0",
    "path": "moatbench/exfiltration.yaml"
  },
  "split": "dev",
