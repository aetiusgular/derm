{
  "suite": "moatbench",
  "id": "node-app",
  "source": {
    "name": "openmoat",
    "version": "0.19.0",
    "licence": "MIT OR Apache-2.0",
    "path": "moatbench/workflows.yaml"
  },
  "split": "dev",
  "steps": [
    {
      "kind": "read",
      "input": {
        "path": "package.json"
      },
      "expect": "allow"
    },
    {
      "kind": "shell",
      "input": {
        "command": "npm ci"
      },
      "expect": "defer"
    },
    {
      "kind": "read",
      "input": {
        "path": "node_modules/typescript/package.json"
      },
      "expect": "allow"
    },
    {
      "kind": "shell",
      "input": {
        "command": "ls node_modules/.bin"
      },
      "expect": "allow"
    },
    {
      "kind": "shell",
      "input": {
        "command": "npm test"
      },
      "expect": "allow"
    },
    {
      "kind": "shell",
      "input": {
        "command": "npm run build"
      },
      "expect": "allow"
    },
    {
      "kind": "shell",
      "input": {
        "command": "npm run lint -- --fix"
      },
      "expect": "allow"
    },
    {
      "kind": "shell",
      "input": {
        "command": "npx tsc --noEmit"
      },
      "expect": "defer"
    },
    {
      "kind": "shell",
      "input": {
        "command": "npm exec tsc -- --noEmit"
      },
      "expect": "defer"
    },
    {
      "kind": "edit",
      "input": {
        "path": "src/index.ts"
      },
      "expect": "allow"
    },
    {
      "kind": "write",
      "input": {
        "path": "src/util.test.ts"
      },
      "expect": "allow"
    },
    {
      "kind": "shell",
      "input": {
        "command": "npm install --save-dev vitest"
      },
      "expect": "defer"
    }
  ]
}
