+ */
+export function headCommands(folded: string, heads: ReadonlySet<string>): string[][] {
+  const out: string[][] = [];
+  const texts = [folded, folded.replace(/\\/g, "")].map((t) => t.replace(/`/g, "\n"));
+  for (const text of texts) walk(text, heads, 0, out);
