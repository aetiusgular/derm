+  if (word === flag || word.startsWith(`${flag}=`)) return true;
+  // A single-letter short flag inside a cluster of short flags (`-fu`).
+  return /^-[a-z0-9]$/.test(flag) && /^-[a-z0-9]{2,}$/.test(word) && word.includes(flag.slice(1));
