+  for (let i = 0; i < words.length; i++) {
+    const w = words[i] as string;
+    if (w === "--") return undefined;
+    if (!w.startsWith("-")) return undefined;
+    if (/^-[a-z]*c[a-z]*$/.test(w)) return words[i + 1];
+    if (w === "-o" || w === "+o") i++;
