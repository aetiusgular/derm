+    if (typeof w !== "string") return `command word ${i} is not a string`;
+    if (COMMAND_WORD.test(w)) continue;
+    if (i > 0 && COMMAND_FLAG_WORD.test(w)) continue;
+    return `command word ${i} is not a plain lowercase word`;
+  }
+  return undefined;
