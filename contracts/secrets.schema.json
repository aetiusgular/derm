{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aetiusgular/derm/contracts/secrets.schema.json",
  "title": "derm secrets",
  "description": "~/.derm/secrets.json (wave 6 lane 6C; contracts/policy.md section 8; the wave 6 base, 12 Nov 2026): the secrets derm-egress injects, by id, with the hosts each may go to and where its value is read at chat start. Never a value. Written only by `derm secret` from a terminal; owner-only, as the policy file.",
  "type": "object",
  "required": ["version", "secrets"],
  "properties": {
    "version": { "const": 1 },
    "secrets": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["id", "hosts", "from"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
          "hosts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$" }
          },
          "from": {
            "oneOf": [
              { "type": "object", "required": ["env"], "properties": { "env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" } }, "additionalProperties": false },
              { "type": "object", "required": ["file"], "properties": { "file": { "type": "string", "pattern": "^/" } }, "additionalProperties": false },
              { "type": "object", "required": ["keychain"], "properties": { "keychain": { "type": "string", "minLength": 1, "maxLength": 128 } }, "additionalProperties": false }
            ]
          },
          "placement": {
            "description": "Where else the value is swapped in toward the secret's own hosts, beside the request's headers: its body, its query, or both. Absent: headers only (decision 2, Tony's call of 12 Nov; integration w6's close). Written by `derm secret add --in body|query`.",
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": { "enum": ["body", "query"] }
          },
          "note": { "type": "string", "maxLength": 200 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
