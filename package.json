{
  "name": "derm-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/derm-pi",
    "packages/derm-claude-plugin",
    "packages/derm-codex-plugin",
    "packages/derm-opencode-plugin",
    "packages/derm-gemini-extension",
    "packages/derm-hermes-plugin",
    "packages/derm-openclaw-plugin",
    "packages/derm-kilo-plugin",
    "packages/derm-hooks-claude-compat",
    "packages/derm-hooks-native",
    "packages/derm-amp-plugin",
    "packages/derm-cline",
    "library"
  ],
  "scripts": {
    "check": "tsc --noEmit && vitest run",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "scope": "node scripts/lane-scope.mjs",
    "scope:self-test": "node scripts/lane-scope.test.mjs"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "ajv": "8.20.0",
    "typescript": "5.8.3",
    "vitest": "3.2.7"
  }
}
