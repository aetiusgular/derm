# systemd user unit for derm-daemon, as the .deb installs it
# (/usr/lib/systemd/user/). Installed, not enabled. To start it:
#
#   systemctl --user enable --now derm-daemon.service
#
# The socket is $XDG_RUNTIME_DIR/derm/daemon.sock (systemd sets it to
# /run/user/<uid>; derm finds that folder too from a shell that does not set
# the variable, such as Tailscale SSH), the log ~/.local/share/derm
# (or $XDG_DATA_HOME/derm). The daemon makes no outbound connection.
# To keep it running after logout: loginctl enable-linger <user>.

[Unit]
Description=derm daemon: OTLP receiver, activity log and approval socket

[Service]
Type=simple
ExecStart=/usr/bin/derm-daemon --foreground
Restart=on-failure
RestartSec=2
UMask=0077
# No NoNewPrivileges=, and none of the settings systemd.exec(5) says imply it
# (SystemCallFilter=, RestrictNamespaces=, PrivateDevices= and the others):
# the person check runs Linux-PAM's unix_chkpwd, which reads /etc/shadow
# through its set-group-id bit, and under no_new_privs that bit is ignored,
# so every password would fail (box test w5, BW5-17). derm-daemon refuses a
# yes that needs the check, and says why, if no_new_privs is set anyway.

[Install]
WantedBy=default.target
