{
  "id": "kimi",
  "name": "Kimi Code",
  "cli": "kimi",
  "mcpFile": "~/.kimi-code/mcp.json",
  "toolNameForm": "mcp__s__t",
  "verified": "TODO",
  "coverage": {
    "tier": "G",
    "orcaId": "kimi",
    "gate": {
      "family": "command-hook",
      "where": "[[hooks]] in ~/.kimi-code/config.toml, keys event, command, timeout",
      "status": "built",
      "wave": 4,
      "lane": "L",
      "package": "packages/derm-hooks-claude-compat"
    },
    "failMode": "open",
    "failSwitch": null,
    "ask": "approver-or-deny",
    "shellAliases": ["powershell"],
    "verifiedAt": "2.4.1, run (cloud, fake chat server)",
    "note": "an unknown key in one hooks entry drops the whole hooks section (run); reads only a deny"
  }
}
